    {
      "parameters": {
        "jsCode": "const text = ($json.message?.text || \"\").trim().toLowerCase();\n\nconst commandMap = {\n  \"/reorder\": null,\n  \"/surge\": \"SURGE\",\n  \"/starve\": \"STARVE\",\n  \"/drain\": \"DRAIN\",\n  \"/blaze\": \"BLAZE\",\n  \"/taper\": \"TAPER\",\n  \"/onset\": \"ONSET\",\n  \"/ghost\": \"GHOST\",\n  \"/bloat\": \"BLOAT\",\n  \"/inert\": \"INERT\"\n};\n\nif (!(text in commandMap)) {\n  return [{\n    json: {\n      supported: false,\n      text: \"Unknown command. Use /reorder, /surge, /starve, /drain, /blaze, /taper, /onset, /ghost, /bloat, or /inert.\"\n    }\n  }];\n}\n\nconst triggerWord = commandMap[text];\nconst companyGuid = \"f3e9df46-fc4f-4b85-930a-abe1e427e900\";\nconst asOfDate = \"2025-07-30\";\nconst threshold = 100000;\n\nconst baseUrl = \"http://localhost:3001/api/sync/reorder-levels\";\nconst url = triggerWord\n  ? `${baseUrl}/${triggerWord}?company_guid=${companyGuid}&as_of_date=${asOfDate}&threshold=${threshold}`\n  : `${baseUrl}?company_guid=${companyGuid}&as_of_date=${asOfDate}&threshold=${threshold}`;\n\nreturn [{\n  json: {\n    supported: true,\n    original_command: text,\n    triggerWord,\n    url\n  }\n}];\n"
      },
