    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst items = data.items || [];\n\nconst headers = [\n  \"Item Name\",\n  \"Avg Sale (6m)\",\n  \"Last Month Purchase\",\n  \"Closing Stock\",\n  \"Reorder Level\",\n  \"Reorder At\",\n  \"Current Quantity\",\n  \"Reorder Quantity\"\n];\n\nfunction esc(value) {\n  const text = String(value ?? \"\");\n  if (text.includes(\",\") || text.includes('\"') || text.includes(\"\\n\")) {\n    return `\"${text.replace(/\"/g, '\"\"')}\"`;\n  }\n  return text;\n}\n\nconst lines = [\n  headers.join(\",\"),\n  ...items.map(item => [\n    item.stock_item_name,\n    item.avg_sale_6m,\n    item.last_month_purchase,\n    item.closing_stock_value,\n    item.reorder_level,\n    item.reorder_at,\n    item.current_quantity,\n    item.reorder_quantity\n  ].map(esc).join(\",\"))\n];\n\nconst csv = lines.join(\"\\n\");\nconst trigger = data.trigger_word_filter || \"ALL\";\nconst asOf = data.as_of_date || \"unknown-date\";\nconst fileName = `reorder_report_${trigger}_${asOf}.csv`;\n\nreturn [\n  {\n    json: {\n      fileName\n    },\n    binary: {\n      data: {\n        data: Buffer.from(csv, \"utf8\").toString(\"base64\"),\n        mimeType: \"text/csv\",\n        fileName\n      }\n    }\n  }\n];\n"
      },
