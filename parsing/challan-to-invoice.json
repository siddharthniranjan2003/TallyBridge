    {
      "parameters": {
        "jsCode": "const result = $input.first().json;\nconst s = result.summary || {};\nconst rows = result.rows || [];\n\nconst lines = rows.map(r =>\n  `${r.line_no}. ${r.minicpm_read} → ${r.stock_matched} [${r.verdict}]`\n);\n\nconst header = `Challan processed ✅\\nRows: ${s.row_count} | Exact: ${s.exact} | Close+: ${s.close_or_better} | Diff: ${s.different} | Time: ${s.inference_seconds}s\\n\\n`;\nconst body = lines.join('\\n');\nconst full = header + body;\nconst text = full.length > 4000 ? full.slice(0, 4000) + '\\n...' : full;\n\nreturn [{ json: { text, chat_id: $('Telegram Trigger').item.json.message.chat.id } }];"
      },
