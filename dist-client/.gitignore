# Build output. Only the client installer .exe is committed; everything else here
# is regenerated by:
#   native-stack\build-client-package.ps1
#   local-supabase\build-client-package.ps1
#   native-stack\build-installer.ps1
#
# The flattened script packages are excluded because every file in them is a copy
# of something already tracked elsewhere in the repo, so committing them would
# double the review surface and let the copies drift from their sources.
tallybridge-native/
tallybridge-supabase/
