# Generated by scripts/bootstrap.mjs from templates/Caddyfile.template.
#
# This file is the entire reason a gateway exists in the native stack.
#
# supabase-js builds ${baseUrl}/rest/v1/<table> (SupabaseClient.ts:341) and the
# Python engine does the same (cloud_pusher.py:225). Plain PostgREST serves tables
# at /<table> and has NO url-prefix option, so without this rewrite every single
# query 404s. That was the defect in design v1, which pointed the app straight at
# postgrest.exe.
#
# handle_path strips the matched prefix before proxying. `handle` does NOT --
# swapping them forwards /rest/v1/stock_items to PostgREST verbatim and you get
# back the exact 404 the gateway was added to prevent.

{
	# No admin API: it would listen on 2019 and offer unauthenticated config
	# reads and writes on a machine holding the client's ledger.
	admin off
	# Everything here is loopback, so there is nothing to get a certificate for.
	# Left on, Caddy would try to provision one and fail noisily.
	auto_https off
}

:${GATEWAY_PORT} {
	handle_path /rest/v1/* {
		reverse_proxy 127.0.0.1:${POSTGREST_PORT}
	}

	# Anything else is a client pointed at the wrong path. Say so, rather than
	# letting Caddy return a bare 200 with an empty body, which looks like a
	# working endpoint returning no rows.
	handle {
		respond "TallyBridge gateway: only /rest/v1/* is served here" 404
	}
}
