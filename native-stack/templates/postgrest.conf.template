# Generated by scripts/bootstrap.mjs from templates/postgrest.conf.template.
# Contains this machine's Postgres password and JWT secret -- gitignored.

db-uri        = "postgres://authenticator:${POSTGRES_PASSWORD}@127.0.0.1:${PGPORT}/${POSTGRES_DB}"
db-schemas    = "public"

# The role an UNAUTHENTICATED request runs as. There is no Kong in this stack, so
# nothing rejects a request before it reaches here -- anon is the security
# boundary, and 903_lockdown_anon.sql strips every table privilege from it.
# Measured before that file existed: an unauthenticated GET returned the whole
# stock table.
db-anon-role  = "anon"

# Verifies the service_role / anon JWTs the app sends as `Authorization: Bearer`.
# supabase-js also sends the key in an `apikey` header; PostgREST ignores that one
# (it is Kong's convention), which is why the native stack needs no equivalent.
jwt-secret    = "${JWT_SECRET}"

server-host   = "127.0.0.1"
server-port   = ${POSTGREST_PORT}

# The MRP report fans out into ~150 chunked requests for one page load.
db-pool       = 10

db-use-legacy-gucs = false
