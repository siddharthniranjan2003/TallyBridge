<?xml version="1.0" encoding="UTF-8"?>
<!--
  Generated by scripts/bootstrap.mjs. One file per service.

  NOTE FOR ANYONE EDITING THE COMMENTS IN THIS FILE: a double hyphen is ILLEGAL
  inside an XML comment. The house style elsewhere in this repo uses one as an
  ASCII em-dash, and doing that here produces four malformed service definitions
  that WinSW refuses to parse. bootstrap.mjs now validates every rendered XML for
  exactly this reason.

  WinSW rather than NSSM: NSSM's last release is 2.24 from 2014 and is unsigned,
  which matters because antivirus quarantining an unsigned binary WEEKS after a
  clean install is one of the named failure modes for this deployment. WinSW is
  maintained, ships signed releases, and takes its whole configuration from this
  file instead of a registry write.
-->
<service>
  <id>${ID}</id>
  <name>${NAME}</name>
  <description>${DESCRIPTION}</description>

  <executable>${EXECUTABLE}</executable>
  <arguments>${ARGUMENTS}</arguments>
  ${STOP}

  <!--
    A Windows service inherits none of an interactive shell's PATH. For PostgREST
    that is fatal and silent: postgrest.exe is not self-contained on Windows, and
    without libpq.dll it exits 0xC0000135 (STATUS_DLL_NOT_FOUND) having written
    nothing to stdout, stderr or the event log. It reads as a corrupt binary.
  -->
  ${EXTRA_PATH}
  ${DEPENDS}
  ${WORKINGDIR}

  <startmode>Automatic</startmode>

  <!--
    The point of the native stack: services start with the machine, before and
    without any user logging in. Docker Desktop cannot do that, which is why an
    unattended reboot silently stops the client's reports.
  -->
  <onfailure action="restart" delay="10 sec" />
  <onfailure action="restart" delay="30 sec" />
  <onfailure action="restart" delay="60 sec" />
  <resetfailure>1 hour</resetfailure>

  <logpath>${LOGPATH}</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>4</keepFiles>
  </log>

  <!-- Long enough for Postgres to checkpoint instead of being killed mid-write. -->
  <stoptimeout>60 sec</stoptimeout>
</service>
